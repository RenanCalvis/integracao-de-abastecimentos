# Copie este arquivo para .env e preencha com suas credenciais reais.

# Fuso Horário de Mato Grosso do Sul (Dourados / Campo Grande - UTC-4)
TZ=America/Campo_Grande
PGTZ=America/Campo_Grande

# Ambiente de execução (development | production | test)
NODE_ENV=production


# Token de autenticação Bearer para consumir a API externa fonte
API_TOKEN=seu_bearer_token_aqui

# URL base da API externa somente-leitura
BASE_URL=https://api.exemplo.com

# Limite de itens por requisição no lote de sincronização incremental
LIMIT_SYNC=50

# Configurações do Banco de Dados PostgreSQL
DB_USER=seu_usuario_banco
DB_PASSWORD=sua_senha
DB_NAME=seu_banco_de_dados
DATABASE_URL=postgresql://seu_usuario_banco:sua_senha_segura@db:5432/seu_banco_de_dados

# Configurações do MinIO S3 Object Storage (Armazenamento de Comprovantes)
MINIO_ACCESS_KEY=minio_access_key_exemplo
MINIO_SECRET_KEY=minio_secret_key_exemplo
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:3103

# Configurações do Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3101
